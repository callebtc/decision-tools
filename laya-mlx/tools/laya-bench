#!/usr/bin/env -S uv run --script
"""Benchmark Laya local inference. Run: ./tools/laya-bench [--model ID]"""

import argparse
import statistics
import subprocess
import sys
import time

import mlx.core as mx
from rich.console import Console
from rich.panel import Panel
from rich.progress import (BarColumn, Progress, SpinnerColumn, TextColumn,
                           TimeElapsedColumn)
from rich.table import Table

import laya_mlx as laya
from laya_mlx.agent import collate_items

QUESTIONS = {
    "topic": {
        "type": "choice",
        "instructions": "Which category does this text belong to?",
        "criteria": ["billing", "technical", "sales", "other"],
    },
    "urgent": {
        "type": "score",
        "instructions": "How urgent is this text?",
        "criteria": ["not urgent", "soon", "critical"],
    },
    "actionable": {
        "type": "noul",
        "instructions": "Does this text request a concrete action?",
    },
}

FILLER = (
    "The quarterly infrastructure review covered replica lag on the billing cluster, "
    "the failed reindex job from Tuesday, and the pending migration of the invoice "
    "pipeline to the new queue workers. Customers in the EU region reported duplicate "
    "charges during the weekend window, and support escalated two tickets to engineering."
)


def sysctl(name: str) -> str:
    try:
        return subprocess.run(
            ["sysctl", "-n", name], capture_output=True, text=True, check=True
        ).stdout.strip()
    except Exception:
        return "?"


def machine_info() -> dict:
    info = {}
    try:
        info["device"] = mx.device_info()["device_name"]
    except Exception:
        info["device"] = sysctl("machdep.cpu.brand_string")
    try:
        info["memory"] = f"{int(sysctl('hw.memsize')) / 1024**3:.0f} GiB"
    except Exception:
        info["memory"] = "?"
    return info


def percentile(samples: list[float], q: float) -> float:
    ordered = sorted(samples)
    if len(ordered) == 1:
        return ordered[0]
    pos = (len(ordered) - 1) * q
    lo, hi = int(pos), min(int(pos) + 1, len(ordered) - 1)
    return ordered[lo] + (ordered[hi] - ordered[lo]) * (pos - lo)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--model", default="aac6fef/laya-mlx")
    parser.add_argument("--dtype", choices=["float16", "float32"], default="float16")
    parser.add_argument("--batch-size", type=int, default=64)
    parser.add_argument("--iterations", type=int, default=15)
    parser.add_argument("--compile", action="store_true", help="mx.compile the model (~1% on saturated batches)")
    args = parser.parse_args()

    console = Console()
    info = machine_info()

    with Progress(
        SpinnerColumn(),
        TextColumn("[bold blue]{task.description}"),
        BarColumn(bar_width=24),
        TextColumn("[progress.percentage]{task.percentage:>3.0f}%"),
        TimeElapsedColumn(),
        console=console,
    ) as progress:
        load_task = progress.add_task("Loading checkpoint", total=None)
        agent = laya.load(args.model, dtype=args.dtype, batch_size=args.batch_size,
                          compile=args.compile)
        progress.update(load_task, completed=True)

        cfg_max = agent.cfg.get("max_len", 512)
        short_state = "Please review the attached support conversation and route it."

        # Long state: fill most of the context window, keeping room for questions.
        probe_ids = len(agent.prepare(FILLER, QUESTIONS)[0][0]["ids"])
        tok_per_char = probe_ids / len(FILLER)
        reps = int((cfg_max - 96) / max(1.0, tok_per_char * len(FILLER)))
        long_state = (FILLER + "\n\n") * reps

        one_question = {"topic": QUESTIONS["topic"]}
        workloads = [
            ("short ctx · 1 question", short_state, one_question),
            ("short ctx · 3 questions", short_state, QUESTIONS),
            ("long ctx · 3 questions", long_state, QUESTIONS),
        ]

        # Warmup (compile paths, allocator, downloads all excluded from timing)
        warm = progress.add_task("Warmup", total=len(workloads) + 1)
        for _, state, qs in workloads:
            agent.predict(state, qs)
            progress.advance(warm)
        progress.update(warm, completed=True)

        results = []
        for name, state, qs in workloads:
            task = progress.add_task(f"Benching {name}", total=args.iterations)
            samples, tokens = [], 0
            for _ in range(args.iterations):
                t0 = time.perf_counter()
                result = agent.predict(state, qs)
                samples.append(time.perf_counter() - t0)
                tokens = result["usage"]["input_tokens"]
                progress.advance(task)
            results.append({"name": name, "tokens": tokens, "samples": samples})

        # Saturated batching: many states share one forward pass (rows, not calls)
        sat_task = progress.add_task("Saturated batch", total=None)
        sat_items = [
            item
            for i in range(64)
            for item in agent.prepare(f"Request {i}: {short_state}", QUESTIONS)[0]
        ]
        n_rows, width = len(sat_items), args.batch_size

        def sat_once():
            t0 = time.perf_counter()
            for start in range(0, n_rows, width):
                batch = collate_items(
                    sat_items[start : start + width],
                    agent.tok.pad_token_id,
                    pad_to_multiple=agent.pad_to_multiple,
                    max_length=agent.cfg.get("max_len", 512),
                )
                agent.forward(batch)
            return time.perf_counter() - t0

        sat_once()
        sat = {
            "rows": n_rows,
            "toks": sum(len(it["ids"]) for it in sat_items),
            "mean": statistics.mean(sat_once() for _ in range(min(args.iterations, 8))),
            "width": width,
        }
        progress.update(sat_task, completed=True)

    # ---- Report ----
    peak = 0
    try:
        peak = mx.get_peak_memory() / 1024**2
    except Exception:
        pass

    console.print()
    title = f"Laya local benchmark — {info['device']}, {info['memory']} unified memory"
    console.print(Panel.fit(
        f"[bold]{title}[/]\n"
        f"model [cyan]{args.model}[/] · dtype [cyan]{args.dtype}[/] · "
        f"batch size [cyan]{args.batch_size}[/] · {args.iterations} timed iterations per workload",
        border_style="bright_magenta",
    ))

    table = Table(
        title="Throughput — 0 output tokens by design; tokens/s = input tokens evaluated",
        title_justify="left",
    )
    table.add_column("Workload")
    for col in ("tokens/req", "P50", "P95", "req/s", "tok/s"):
        table.add_column(col, justify="right")
    table.add_column("vs best", justify="left")
    best = max(r["tokens"] / statistics.mean(r["samples"]) for r in results)

    for r in results:
        mean_s = statistics.mean(r["samples"])
        rps = 1 / mean_s
        tps = r["tokens"] / mean_s
        n_req = 1 if "1 question" in r["name"] else len(QUESTIONS)
        bar_len = round(12 * tps / best)
        bar = f"[bright_green]{'█' * bar_len}[/]{'░' * (12 - bar_len)}"
        table.add_row(
            r["name"],
            f"{r['tokens'] // n_req:,}",
            f"{percentile(r['samples'], 0.50) * 1000:.1f} ms",
            f"{percentile(r['samples'], 0.95) * 1000:.1f} ms",
            f"{rps:.1f}",
            f"{tps:,.0f}",
            bar,
        )
    console.print(table)

    qps = sat["rows"] / sat["mean"]
    console.print(
        f"Saturated batch — 64 states x 3 questions = {sat['rows']} rows, {sat['width']} rows/forward: "
        f"[bold]{qps:.0f} rows/s[/] (questions/s), {sat['toks'] / sat['mean']:,.0f} tok/s. "
        f"Multi-state batching is the throughput lever; --compile is ~+1% here."
    )

    console.print(
        Panel.fit(
            f"[dim]Latency is per predict() call: one state + its questions, one forward pass.\n"
            f"req/s counts predict() calls; tokens/s counts every evaluated input token.\n"
            f"Latency grows with context length, but tokens/s improves as fixed overhead\n"
            f"amortizes over the longer sequence — longer prompts are more token-efficient.\n"
            f"Peak Metal memory observed: {peak:.0f} MiB[/dim]",
            border_style="dim",
        )
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
