MAX_OPTIONS_PER_SELECT = 12
MAX_REQ_ATTEMPTS = 3                    # fill attempts per requirement before skipping it
MAX_RESULT_WAITS = 8                    # post-submit cycles to wait for results
# Requirement values that mean absence: they need no input, typing the word
# would be nonsense (measured: 'Return = none' typed literally).
NEGATIVE_VALUES = {"none", "no", "null", "empty", "n a", "no return", "not applicable",
                   "nothing", "false"}
# Submit buttons overwhelmingly use one of these words (laya-ultrafast).
SUBMIT_WORDS = {"search", "submit", "go", "apply", "done", "continue",
                "next", "confirm", "suchen"}

# Function words only. Heavier domain words (trip, type, one, way, flight)
